{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rampboard",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  // The Workers free plan rejects a limits.cpu_ms setting. Leave it unset.
  "assets": {
    "directory": "./public"
  },
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.sql"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rampboard",
      // scripts/deploy-prod.sh replaces this when it creates the database.
      // To fill it in by hand, paste the id from `npx wrangler d1 create rampboard`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}

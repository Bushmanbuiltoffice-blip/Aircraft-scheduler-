{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rampboard",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  // Password checks are deliberately slow. Paid Workers accounts can raise the
  // CPU limit below. If deploy rejects cpu_ms, see the README troubleshooting.
  "limits": {
    "cpu_ms": 30000
  },
  "assets": {
    "directory": "./public"
  },
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.sql"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rampboard",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}

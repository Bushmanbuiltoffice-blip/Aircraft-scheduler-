{
  "name": "rampboard",
  "version": "1.0.0",
  "private": true,
  "description": "Aircraft rental and instruction scheduling for Firehound Rental",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run && node --test scripts/database-id.check.mjs && tsx --test scripts/flight-import.check.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply rampboard --local",
    "db:migrate:remote": "wrangler d1 migrations apply rampboard --remote",
    "db:seed:local": "tsx scripts/seed.ts --local",
    "db:seed:remote": "tsx scripts/seed.ts --remote",
    "db:seed:prod": "tsx scripts/seed-prod.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "hono": "4.13.14"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "@cloudflare/workers-types": "5.20261026.1",
    "@types/node": "22.19.1",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.153.0"
  }
}
